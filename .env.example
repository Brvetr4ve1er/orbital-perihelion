# Environment variables for PKOS
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and should NEVER be committed.

# Tambo AI Provider
VITE_TAMBO_API_KEY=your_tambo_api_key_here
VITE_TAMBO_USER_KEY=admin

# LLM Configuration (defaults to local LM Studio)
VITE_LLM_URL=/api/llm
VITE_LLM_MODEL=deepseek/deepseek-r1-0528-qwen3-8b
VITE_LLM_KEY=your_llm_api_key_here
